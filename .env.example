# Copy to .env and edit before running `docker compose up`.

# Public URL of the web console. The Google OAuth redirect URI must be
# ${S3DRIVE_PUBLIC_URL}/oauth/callback.
S3DRIVE_PUBLIC_URL=http://localhost:8080

# Public URL of the S3 endpoint shown in the console. Leave empty to derive
# it from S3DRIVE_S3_ADDR and the browser request.
S3DRIVE_PUBLIC_S3_URL=

# Console password. Use a long random value.
S3DRIVE_UI_PASSWORD=change-me-before-exposing-the-console

# Optional 32-byte key, base64 or hex, e.g. `openssl rand -base64 32`.
# Leave empty to generate and persist /data/master.key inside the volume.
S3DRIVE_MASTER_KEY=

# Set to true only behind a reverse proxy you control.
S3DRIVE_TRUST_PROXY=false

S3DRIVE_LOG_LEVEL=info

# Operational limits (defaults shown).
S3DRIVE_MAX_OBJECT_BYTES=5TiB
S3DRIVE_DAILY_UPLOAD_BYTES=750GiB
S3DRIVE_MAX_CONCURRENT_UPLOADS=4
S3DRIVE_DISK_RESERVE_BYTES=1GiB
S3DRIVE_MAX_UI_BODY_BYTES=1GiB
S3DRIVE_SHUTDOWN_TIMEOUT=5m

# Console login rate limiting.
S3DRIVE_LOGIN_MAX_FAILURES=5
S3DRIVE_LOGIN_WINDOW=15m
S3DRIVE_LOGIN_LOCKOUT=15m
